#!/data/data/com.termux/files/usr/bin/bash

echo ""
echo "=========================================="
echo "   WEBSITE CHECK BEFORE GIT PUSH"
echo "=========================================="
echo ""

python check_site.py

RESULT=$?

if [ $RESULT -ne 0 ]; then
    echo ""
    echo "=========================================="
    echo "   PUSH BLOCKED"
    echo "   Fix the errors above first."
    echo "=========================================="
    exit 1
fi

echo ""
echo "=========================================="
echo "   WEBSITE CHECK PASSED"
echo "   Continuing with Git push..."
echo "=========================================="
echo ""

exit 0

